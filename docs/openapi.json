  "components": {
    "schemas": {
      "Candidate": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "input",
              "output",
              "tool"
            ],
            "title": "Stage"
          },
          "text": {
            "type": "string",
            "maxLength": 32000,
            "title": "Text",
            "default": ""
          },
          "tool": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stage"
        ],
        "title": "Candidate"
      },
      "CheckRequest": {
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/Candidate"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate"
        ],
        "title": "CheckRequest"
      },
      "Decision": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "stage": {
            "type": "string",
            "enum": [
              "input",
              "output",
              "tool"
            ],
            "title": "Stage"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "action_probabilities": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Action Probabilities"
          },
          "nominal_risks": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Nominal Risks"
          },
          "upper_risks": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Upper Risks"
          },
          "blocked_actions": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Blocked Actions"
          },
          "belief": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Belief"
          },
          "protocol_state": {
            "type": "string",
            "title": "Protocol State"
          },
          "candidate_digest": {
            "type": "string",
            "title": "Candidate Digest"
          },
          "policy_digest": {
            "type": "string",
            "title": "Policy Digest"
          },
          "risk_semantics": {
            "type": "string",
            "enum": [
              "model_score",
              "conditional_bound"
            ],
            "title": "Risk Semantics"
          },
          "risk_allowance": {
            "type": "number",
            "title": "Risk Allowance"
          },
          "consumed_allowance": {
            "type": "number",
            "title": "Consumed Allowance"
          },
          "observation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "revision",
          "stage",
          "action",
          "allowed",
          "message",
          "reasons",
          "action_probabilities",
          "nominal_risks",
          "upper_risks",
          "blocked_actions",
          "belief",
          "protocol_state",
          "candidate_digest",
          "policy_digest",
          "risk_semantics",
          "risk_allowance",
          "consumed_allowance"
        ],
        "title": "Decision"
      },
      "EventRequest": {
        "properties": {
          "event": {
            "type": "string",
            "maxLength": 64,
            "title": "Event"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
