      "ExecuteRequest": {
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Tool"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "execution_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Execution Id"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "execution_id"
        ],
        "title": "ExecuteRequest"
      },
      "GrantRequest": {
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Tool"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "ttl_seconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Ttl Seconds",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool"
        ],
        "title": "GrantRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ToolResult": {
        "properties": {
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "executed": {
            "type": "boolean",
            "title": "Executed"
          },
          "released": {
            "type": "boolean",
            "title": "Released"
          },
          "result": {
            "title": "Result"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "output_decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Decision"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "execution_id",
          "executed",
          "released",
          "decision"
        ],
        "title": "ToolResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
