      "additionalProperties": {
        "$ref": "#/$defs/ToolSpec"
      },
      "title": "Tools",
      "type": "object"
    },
    "temperature": {
      "default": 0.7,
      "exclusiveMinimum": 0,
      "maximum": 100,
      "title": "Temperature",
      "type": "number"
    },
    "risk_threshold": {
      "default": 0.2,
      "maximum": 1,
      "minimum": 0,
      "title": "Risk Threshold",
      "type": "number"
    },
    "uncertainty_radius": {
      "default": 0.02,
      "maximum": 1,
      "minimum": 0,
      "title": "Uncertainty Radius",
      "type": "number"
    },
    "selection": {
      "default": "max",
      "enum": [
        "max",
        "sample"
      ],
      "title": "Selection",
      "type": "string"
    },
    "risk_semantics": {
      "default": "model_score",
      "enum": [
        "model_score",
        "conditional_bound"
      ],
      "title": "Risk Semantics",
      "type": "string"
    },
    "envelope_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Envelope Description"
    },
    "session_alpha": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Alpha"
    },
    "max_decisions": {
      "default": 100,
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Decisions",
      "type": "integer"
    },
    "max_clarifications": {
      "default": 3,
      "maximum": 100,
      "minimum": 0,
      "title": "Max Clarifications",
      "type": "integer"
    },
    "session_ttl_seconds": {
      "default": 3600,
      "maximum": 604800,
      "minimum": 1,
      "title": "Session Ttl Seconds",
      "type": "integer"
    }
