      "type": "string"
    },
    "safe_protocol_states": {
      "items": {
        "type": "string"
      },
      "title": "Safe Protocol States",
      "type": "array"
    },
    "closed_state": {
      "default": "closed",
      "title": "Closed State",
      "type": "string"
    },
    "verified_states": {
      "items": {
        "type": "string"
      },
      "title": "Verified States",
      "type": "array"
    },
    "trusted_events": {
      "items": {
        "type": "string"
      },
      "title": "Trusted Events",
      "type": "array"
    },
    "protocol_rules": {
      "items": {
        "$ref": "#/$defs/ProtocolRule"
      },
      "title": "Protocol Rules",
      "type": "array"
    },
    "patterns": {
      "items": {
        "$ref": "#/$defs/PatternRule"
      },
      "title": "Patterns",
      "type": "array"
    },
